{
  "name": "vanreenen-blog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/prepare-content.ts --drafts && vite --host 127.0.0.1 --port 4187",
    "routes": "node --import tsx scripts/prepare-content.ts && node --import tsx scripts/generate-routes.ts",
    "typecheck": "npm run routes && tsc --noEmit",
    "build": "node --import tsx scripts/prepare-content.ts && vite build && tsc --noEmit && node --import tsx scripts/finalize-static.ts",
    "preview": "vite preview --config vite.preview.config.ts --host 127.0.0.1 --port 4188",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src scripts tests *.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tabler/icons-react": "3.51.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "lucide-react": "1.61.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.64.1",
    "@shikijs/rehype": "4.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-generator": "1.167.46",
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.13",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "gray-matter": "4.0.3",
    "jsqr": "1.4.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.89.0",
    "playwright-core": "1.64.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "shadcn": "4.22.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.20.0"
}
